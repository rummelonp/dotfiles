{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "235000"
  },
  "permissions": {
    "allow": [
      "Bash(aws * describe-*)",
      "Bash(aws * get-*)",
      "Bash(aws * list-*)",
      "Bash(aws logs filter-*)",
      "Bash(aws logs tail:*)",
      "Bash(aws s3 ls:*)",
      "Bash(bash:*)",
      "Bash(brew info:*)",
      "Bash(brew search:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(claude mcp:*)",
      "Bash(corepack:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(cut:*)",
      "Bash(date:*)",
      "Bash(devcontainer:*)",
      "Bash(diff:*)",
      "Bash(dig:*)",
      "Bash(docker:*)",
      "Bash(echo:*)",
      "Bash(emacsclient:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(gcloud * describe*)",
      "Bash(gcloud * list*)",
      "Bash(gcloud logging read:*)",
      "Bash(gcloud storage cat:*)",
      "Bash(gcloud storage ls:*)",
      "Bash(gh:*)",
      "Bash(ghq:*)",
      "Bash(git:*)",
      "Bash(go:*)",
      "Bash(grep:*)",
      "Bash(gsutil cat:*)",
      "Bash(gsutil ls:*)",
      "Bash(head:*)",
      "Bash(http:*)",
      "Bash(jq:*)",
      "Bash(less:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(node:*)",
      "Bash(nodenv:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(open:*)",
      "Bash(ping:*)",
      "Bash(pkill:*)",
      "Bash(pnpm:*)",
      "Bash(ps:*)",
      "Bash(python3:*)",
      "Bash(rg:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(ruby:*)",
      "Bash(sed:*)",
      "Bash(tail:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform validate:*)",
      "Bash(test:*)",
      "Bash(timeout:*)",
      "Bash(tmux:*)",
      "Bash(tree:*)",
      "Bash(tsc:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(yarn:*)",
      "Edit(//private/tmp/**)",
      "Edit(//tmp/**)",
      "Read(//private/tmp/**)",
      "Read(//tmp/**)",
      "WebFetch(domain:*)",
      "WebSearch",
      "mcp__Control_Chrome__get_page_content",
      "mcp__Control_Chrome__list_tabs",
      "mcp__chrome-devtools__get_console_message",
      "mcp__chrome-devtools__get_network_request",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__new_page",
      "mcp__chrome-devtools__resize_page",
      "mcp__chrome-devtools__select_page",
      "mcp__chrome-devtools__take_screenshot"
    ],
    "deny": [
      "Bash(aws * get-*credential*)",
      "Bash(aws * get-*token*)",
      "Bash(aws * get-api-keys*)",
      "Bash(aws * get-login-password*)",
      "Bash(aws * get-parameter*)",
      "Bash(aws * get-password-data*)",
      "Bash(aws * get-secret-value*)",
      "Bash(cargo publish:*)",
      "Bash(chmod 777 /*)",
      "Bash(dd:*)",
      "Bash(deno publish:*)",
      "Bash(fdisk:*)",
      "Bash(gcloud auth print-*)",
      "Bash(gcloud secrets versions access:*)",
      "Bash(mkfs:*)",
      "Bash(npm publish:*)",
      "Bash(op get:*)",
      "Bash(op item get:*)",
      "Bash(op read:*)",
      "Bash(pnpm publish:*)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(sudo -i:*)",
      "Bash(sudo chmod 777:*)",
      "Bash(sudo chown:*)",
      "Bash(sudo dd:*)",
      "Bash(sudo fdisk:*)",
      "Bash(sudo mkfs:*)",
      "Bash(sudo mount:*)",
      "Bash(sudo rm:*)",
      "Bash(sudo su:*)",
      "Bash(sudo umount:*)",
      "Bash(yarn publish:*)",
      "Edit(.git/**)",
      "Edit(node_modules/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.gsutil/**)",
      "Read(~/.npmrc)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(gh issue comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(git * clean *)",
      "Bash(git clean:*)",
      "Bash(git push:*)",
      "Bash(op run:*)",
      "Bash(rm -rf:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "mcp__chrome-devtools__evaluate_script"
    ]
  },
  "model": "opus[1m]",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "少女祈祷中"
    ]
  },
  "plansDirectory": ".claude/plans",
  "tui": "fullscreen",
  "theme": "dark-daltonized"
}
