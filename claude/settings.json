{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "235000",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "CLAUDE_SECURITY_SCAN_TIP": "off"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(cut:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh search:*)",
      "Bash(git add:*)",
      "Bash(git check-ignore:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "Bash(jq:*)",
      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "Bash(pnpm fix*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm vitest*)",
      "Bash(ps:*)",
      "Bash(rg:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform validate:*)",
      "Edit(//private/tmp/**)",
      "Edit(//tmp/**)",
      "Read(//private/tmp/**)",
      "Read(//tmp/**)",
      "WebFetch(domain:*)",
      "WebSearch",
      "mcp__Claude_Code_iOS_Simulator__control",
      "mcp__Control_Chrome__get_page_content",
      "mcp__Control_Chrome__list_tabs",
      "mcp__chrome-devtools__get_console_message",
      "mcp__chrome-devtools__get_network_request",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__new_page",
      "mcp__chrome-devtools__resize_page",
      "mcp__chrome-devtools__select_page",
      "mcp__chrome-devtools__take_screenshot"
    ],
    "deny": [
      "Agent(claude-security:claude-security)",
      "Bash(*cf *access token*)",
      "Bash(*cf *service-tokens*)",
      "Bash(*cf *temporary-credentials*)",
      "Bash(*cf *token get*)",
      "Bash(*cf *tokens create*)",
      "Bash(*cf *tokens roll*)",
      "Bash(*wrangler *auth token*)",
      "Bash(*wrangler *issue-token*)",
      "Bash(*wrangler *registries credentials*)",
      "Bash(aws * get-*token*)",
      "Bash(aws * get-login-password*)",
      "Bash(aws * get-parameter*)",
      "Bash(aws * get-secret-value*)",
      "Bash(cargo publish:*)",
      "Bash(cloudflare *)",
      "Bash(deno publish:*)",
      "Bash(gcloud * config-helper*)",
      "Bash(gcloud * docker-helper*)",
      "Bash(gcloud * git-helper*)",
      "Bash(gcloud * print-*token*)",
      "Bash(gcloud * service-accounts keys create*)",
      "Bash(gcloud * versions access*)",
      "Bash(gcloud *auth describe*)",
      "Bash(gh auth git-credential*)",
      "Bash(gh auth status*-t*)",
      "Bash(gh auth token:*)",
      "Bash(git credential*)",
      "Bash(git fetch *--upl*)",
      "Bash(npm * publish*)",
      "Bash(npm publish:*)",
      "Bash(op * item get*)",
      "Bash(op * read*)",
      "Bash(op item get:*)",
      "Bash(op read:*)",
      "Bash(pnpm * publish*)",
      "Bash(pnpm publish:*)",
      "Bash(sudo:*)",
      "Bash(yarn * publish*)",
      "Bash(yarn publish:*)",
      "Edit(.git/**)",
      "Edit(node_modules/**)",
      "Read(~/.authinfo)",
      "Read(~/.aws/**)",
      "Read(~/.claude.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.gemini/oauth_creds.json)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.gsutil/**)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/Library/Preferences/.wrangler/config/**)",
      "Read(~/Library/Preferences/cloudflare/config/**)",
      "Skill(claude-security:claude-security)"
    ],
    "ask": [
      "Bash(*wrangler *--remote*)",
      "Bash(*wrangler *delete*)",
      "Bash(*wrangler *deploy *)",
      "Bash(*wrangler *deploy)",
      "Bash(*wrangler *purge*)",
      "Bash(*wrangler *restore*)",
      "Bash(*wrangler *rollback*)",
      "Bash(*wrangler *secret bulk*)",
      "Bash(*wrangler *secret put*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh issue transfer:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit *--add-assignee*)",
      "Bash(gh pr edit *--add-label*)",
      "Bash(gh pr edit *--add-reviewer*)",
      "Bash(gh pr edit *--base*)",
      "Bash(gh pr edit *--remove-label*)",
      "Bash(gh pr edit *-B *)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh pr revert:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr update-branch:*)",
      "Bash(git -* ps*)",
      "Bash(git -* push*)",
      "Bash(git commit * -n*)",
      "Bash(git commit *--no-veri*)",
      "Bash(git commit -n*)",
      "Bash(git ps*)",
      "Bash(git push*)",
      "Bash(git switch * -f*)",
      "Bash(git switch *--di*)",
      "Bash(git switch *--force*)",
      "Bash(git switch -f*)",
      "Bash(op run:*)",
      "Bash(terraform * apply*)",
      "Bash(terraform * destroy*)",
      "Bash(terraform * import*)",
      "Bash(terraform * state*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)"
    ]
  },
  "model": "opus[1m]",
  "language": "japanese",
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true,
    "explainer@explainer": true,
    "codex@openai-codex": true,
    "cloudflare@cloudflare": true,
    "claude-security@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "explainer": {
      "source": {
        "source": "github",
        "repo": "mizchi/explainer"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo '特に指示がない限り、ユーザーへの応答は日本語で行う。'"
          }
        ]
      }
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "少女祈祷中"
    ]
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "plansDirectory": ".claude/plans",
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "agentPushNotifEnabled": true
}